# ── Auth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=https://your-app.vercel.app

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── AI — Hugging Face (Kimi K2) ────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_token_here

# ── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── OpenClaw Messaging Gateway ─────────────────────────────────────────────
OPENCLAW_SECRET=your_shared_secret_here

# ── Render Server ─────────────────────────────────────────────────────────
# URL of your Render server (set after deploying to Render)
RENDER_SERVER_URL=https://lbrain-server.onrender.com
# Shared secret between web app and Render server
SERVER_SECRET=generate_random_32_char_string

# ── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
