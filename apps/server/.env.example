# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
SERVER_SECRET=generate_random_32_char_string

# ── Web app URL (Vercel) ───────────────────────────────────────────────────
WEB_APP_URL=https://your-app.vercel.app

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── LBank API (for server-side agent execution) ────────────────────────────
# These are set per-user in Supabase, not globally here
# Global keys only if you have a shared trading account

# ── OpenClaw ───────────────────────────────────────────────────────────────
OPENCLAW_SECRET=your_shared_secret

# ── AI ────────────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_token_here
